# ==============================================================================
# NyayaSetu — DigiLocker & MeriPehchaan OAuth 2.0 Environment Configuration
# ==============================================================================
# In Vercel, set these in: Project Settings -> Environment Variables
# In Local Development, you can copy this file to .env or use digilocker_config.json

# 1. Government Partner Client ID (Issued by NeGD / API Setu)
DIGILOCKER_CLIENT_ID=

# 2. Government Partner Client Secret (Confidential - DO NOT commit to GitHub)
DIGILOCKER_CLIENT_SECRET=

# 3. Environment: "production" (meripehchaan.gov.in) or "sandbox" (api.digitallocker.gov.in)
DIGILOCKER_ENV=production

# 4. Optional Override for Redirect URI (automatically defaults to https://<your-vercel-domain>/callback.html)
# DIGILOCKER_REDIRECT_URI=https://nyayasetu.vercel.app/callback.html

# 5. Organization Name
DIGILOCKER_ENTITY=Ramdeobaba University (RBU) - IDEA Lab NyayaSetu

# Advocate research assistant (separate Gemini key; server-side only)
GEMINI_LAWYER_KEY=
GEMINI_LAWYER_MODEL=gemini-2.5-flash
